# Пример файла переменных окружения
# Скопируйте этот файл в .env и измените значения

# ════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════

# PostgreSQL Connection String
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres:5432/db_admin

# Echo SQL queries (for debugging)
DATABASE_ECHO=False

# Хост для подключений из UI с localhost/127.0.0.1, когда приложение в Docker (имя сервиса Postgres в compose).
DOCKER_PG_HOST=postgres

# ════════════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ════════════════════════════════════════════════════════════

# Redis Connection String
REDIS_URL=redis://redis:6379/0

# ════════════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ════════════════════════════════════════════════════════════

# Secret key for JWT token signing
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-now

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ════════════════════════════════════════════════════════════

# Application name
APP_NAME=DB Administrator

# Application version
APP_VERSION=1.0.0

# Debug mode (set to False in production)
DEBUG=False

# ════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ════════════════════════════════════════════════════════════

# Allowed origins for CORS (comma-separated for multiple)
CORS_ORIGINS=*

# ════════════════════════════════════════════════════════════
# BACKUPS (pg_dump)
# ════════════════════════════════════════════════════════════
# Каталог дампов внутри контейнера (на Windows с volume .:/app лучше не /app/backups).
BACKUP_DIR=/tmp/app_backups
# Режим SSL для libpq (pg_dump) и asyncpg: disable | prefer | require
PGSSLMODE=disable

# ════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=logs/app.log

# ════════════════════════════════════════════════════════════
# PRODUCTION RECOMMENDATIONS
# ════════════════════════════════════════════════════════════
#
# 1. Change SECRET_KEY to a random secure value
# 2. Set DEBUG=False
# 3. Update CORS_ORIGINS to specific domains
# 4. Use environment-specific DATABASE_URL
# 5. Enable HTTPS in reverse proxy (Nginx/Apache)
# 6. Set strong passwords for database
# 7. Configure proper logging
# 8. Set up monitoring and alerts
# 9. Configure backup strategy
# 10. Enable audit logging
